# PostgreSQL — overridden by docker-compose's environment: block for the
# ai-engine/celery-worker services; only needed for running outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiplatform

# Redis — used as Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# Gemini API key — used by the patch generator.
GEMINI_API_KEY=your_gemini_api_key_here

# Orchestrator callback — where to POST AIEngineResponse after processing a job.
ORCHESTRATOR_URL=http://orchestrator:8080

# Shared secret for HMAC-signing responses sent to the orchestrator.
# Must match AI_ENGINE_SECRET in orchestrator/.env exactly.
AI_ENGINE_SECRET=your_ai_engine_secret_here
