# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPOSITORY_URL=https://github.com/your-org/your-repo.git
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# AI Engine Configuration
AI_ENGINE_SECRET=your_ai_engine_secret_here
AI_ENGINE_PORT=8081
AI_ENGINE_REQUEST_TIMEOUT=30

# Server Configuration
PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10
READ_HEADER_TIMEOUT=5
WRITE_TIMEOUT=15

# Execution and Resource Constraints
MAX_TEST_PATCHING_ATTEMPTS=3
CONTAINER_TIMEOUT=60
CONTAINER_MEMORY_CAP=512